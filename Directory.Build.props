<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <JellyfinReferenceDir Condition="'$(JellyfinReferenceDir)' == ''">$(MSBuildThisFileDirectory)refs</JellyfinReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="MediaBrowser.Common;MediaBrowser.Controller;MediaBrowser.Model;Jellyfin.Api;Jellyfin.Data;Jellyfin.Extensions;Jellyfin.Database.Implementations">
      <HintPath>$(JellyfinReferenceDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireTargetAssemblies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(JellyfinReferenceDir)/MediaBrowser.Controller.dll')" Text="Missing target Jellyfin DLLs. Run python3 scripts/fetch_refs.py or extract the running container's /jellyfin DLLs into refs/." />
  </Target>
</Project>
